# Local values come from `npx supabase status -o env` (API_URL, ANON_KEY, SERVICE_ROLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
# Comma-separated emails that may open /admin.
ADMIN_EMAILS=
# SIMULATOR only for now; a Midtrans sandbox provider can replace it later.
PAYMENT_PROVIDER=SIMULATOR
# Any random string of 16+ characters; signs simulated payment notifications.
PAYMENT_WEBHOOK_SECRET=
